# ── Base mainnet fork (anvil / Tenderly virtual testnet) ──────────────
# Aqua + SwapVM are mainnet-only, so the app runs against a fork.
#   anvil --fork-url https://mainnet.base.org --fork-block-number <n> --no-rate-limit
RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=8453

# ── Privy — create an app at https://dashboard.privy.io ───────────────
# Without this the app still loads; wallet features show a "configure Privy" notice.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only secret (keeper session signer). Keep it in .env, never commit it.
PRIVY_APP_SECRET=

# ── Server-side position/rule store (JSON file) ──────────────────────
RULE_STORE_PATH=.data/positions.json
# Keeper run history (JSON file) — defaults to .data/keeper-log.json
# KEEPER_LOG_PATH=.data/keeper-log.json

# ── Keeper signer ────────────────────────────────────────────────────
# Demo keeper: a single local key that signs dock()/withdraw() for every
# position when a rule trips with autoUnwind on. Unset → keeper alerts only.
# (anvil account 0; production swaps this for a Privy session signer.)
# KEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
